if(DEFINED ENV{PARSINAMA_VERSION_TAG} AND NOT "$ENV{PARSINAMA_VERSION_TAG}" STREQUAL "")
    set(PARSINAMA_TAG "$ENV{PARSINAMA_VERSION_TAG}")
elseif(DEFINED ENV{GITHUB_REF_TYPE} AND "$ENV{GITHUB_REF_TYPE}" STREQUAL "tag")
    set(PARSINAMA_TAG "$ENV{GITHUB_REF_NAME}")
else()
    execute_process(
        COMMAND git describe --tags --abbrev=0 --match "v[0-9]*.[0-9]*.[0-9]*"
        WORKING_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/.."
        OUTPUT_VARIABLE PARSINAMA_TAG
        ERROR_VARIABLE PARSINAMA_GIT_ERROR
        RESULT_VARIABLE PARSINAMA_GIT_RESULT
        OUTPUT_STRIP_TRAILING_WHITESPACE
    )
    if(NOT PARSINAMA_GIT_RESULT EQUAL 0)
        message(FATAL_ERROR "No version tag found: ${PARSINAMA_GIT_ERROR}")
    endif()
endif()

if(NOT PARSINAMA_TAG MATCHES "^v[0-9]+\\.[0-9]+\\.[0-9]+$")
    message(FATAL_ERROR "Invalid version tag '${PARSINAMA_TAG}'; expected vMAJOR.MINOR.PATCH")
endif()

string(SUBSTRING "${PARSINAMA_TAG}" 1 -1 PARSINAMA_VERSION)
file(WRITE "${CMAKE_CURRENT_LIST_DIR}/../metadata/VERSION" "${PARSINAMA_VERSION}\n")
